---
import { X } from "lucide-astro";
import PagefindSearch from "./PagefindSearch.astro";
---

<dialog
  id="search-modal"
  aria-labelledby="search-modal-title"
  class="m-auto max-h-[92vh] w-[min(94vw,760px)] overflow-y-auto border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
>
  <div
    class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-700"
  >
    <div>
      <h2 id="search-modal-title" class="text-base font-semibold">搜索知识库</h2>
      <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">按 Esc 关闭并返回原位置</p>
    </div>
    <button
      type="button"
      data-search-close
      class="grid h-11 w-11 place-items-center text-slate-500 transition hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 dark:hover:bg-slate-800 dark:hover:text-white"
      aria-label="关闭搜索"
    >
      <X class="h-5 w-5" />
    </button>
  </div>
  <div class="p-4"><PagefindSearch id="search-modal-control" variant="modal" limit={8} /></div>
</dialog>
<script>
  const modal = document.querySelector<HTMLDialogElement>("#search-modal");
  const input = modal?.querySelector<HTMLInputElement>("[data-pagefind-input]");
  let returnFocus: HTMLElement | null = null;

  const open = (trigger?: EventTarget | null) => {
    if (!modal) return;
    if (modal.open) {
      input?.focus();
      return;
    }
    returnFocus =
      trigger instanceof HTMLElement ? trigger : (document.activeElement as HTMLElement | null);
    modal.showModal();
    window.requestAnimationFrame(() => input?.focus());
  };
  document
    .querySelectorAll("[data-search-open]")
    .forEach((button) => button.addEventListener("click", (event) => open(event.currentTarget)));
  modal?.querySelector("[data-search-close]")?.addEventListener("click", () => modal.close());
  document.addEventListener("keydown", (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      open();
    }
  });
  modal?.addEventListener("pagefind-search-escape", () => {
    if (modal.open) modal.close();
  });
  modal?.addEventListener("click", (event) => {
    if (event.target === modal) modal.close();
  });
  modal?.addEventListener("close", () => {
    const target = returnFocus;
    returnFocus = null;
    if (target?.isConnected) window.requestAnimationFrame(() => target.focus());
  });
</script>
