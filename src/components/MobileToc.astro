---
import { ListTree, X } from "lucide-astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

{
  headings.length > 0 && (
    <div class="xl:hidden">
      <button
        class="mobile-toc-trigger"
        type="button"
        aria-controls="mobile-toc"
        aria-haspopup="dialog"
      >
        <ListTree class="h-4 w-4" />
        目录
      </button>
      <dialog id="mobile-toc" class="mobile-toc-dialog" aria-label="文章目录">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4 dark:border-slate-800">
          <p class="font-semibold text-slate-950 dark:text-white">本页目录</p>
          <button class="icon-button" type="button" data-mobile-toc-close aria-label="关闭目录">
            <X class="h-4 w-4" />
          </button>
        </div>
        <nav class="max-h-[65vh] overflow-y-auto px-5 py-4" aria-label="移动文章目录">
          {headings.map((heading) => (
            <a
              class:list={["toc-link", heading.depth === 3 ? "ml-3" : ""]}
              href={`#${heading.slug}`}
            >
              {heading.text}
            </a>
          ))}
        </nav>
      </dialog>
    </div>
  )
}

<script>
  const tocDialog = document.querySelector<HTMLDialogElement>("#mobile-toc");
  const tocTrigger = document.querySelector<HTMLButtonElement>(".mobile-toc-trigger");
  tocTrigger?.addEventListener("click", () => tocDialog?.showModal());
  document
    .querySelector("[data-mobile-toc-close]")
    ?.addEventListener("click", () => tocDialog?.close());
  tocDialog?.querySelectorAll("a[href^='#']").forEach((link) => {
    link.addEventListener("click", () => tocDialog.close());
  });
</script>
