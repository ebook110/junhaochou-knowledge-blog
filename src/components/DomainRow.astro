---
import { Atom, Network, ServerCog, Workflow } from "lucide-astro";

interface CategoryLink {
  slug: string;
  name: string;
}

interface DomainView {
  slug: string;
  name: string;
  description: string;
  methods: readonly string[];
}

interface Props {
  domain: DomainView;
  categories: CategoryLink[];
}

const { domain, categories } = Astro.props;
const domainIcons = {
  "scientific-computing": Atom,
  "engineering-automation": Workflow,
  "systems-deployment": ServerCog,
  "network-risk": Network,
};
const Icon = domainIcons[domain.slug as keyof typeof domainIcons] ?? Atom;
---

<li class="domain-row">
  <div class="domain-icon" aria-hidden="true">
    <Icon class="h-5 w-5" strokeWidth={1.55} />
  </div>

  <div class="domain-copy">
    <h3>{domain.name}</h3>
    <p>{domain.description}</p>
  </div>

  <p class="domain-methods" aria-label="常用方法">
    {domain.methods.join(" · ")}
  </p>

  <nav class="domain-categories" aria-label={`${domain.name}分类`}>
    {categories.map((category) => <a href={`/categories/${category.slug}/`}>{category.name}</a>)}
  </nav>
</li>

<style>
  .domain-row {
    display: grid;
    min-width: 0;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    border-bottom: 1px solid var(--site-line);
    padding-block: 1.35rem;
  }

  .domain-row:first-child {
    border-top: 1px solid var(--site-line);
  }

  .domain-icon {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--site-line);
    border-radius: var(--site-radius);
    color: var(--site-cobalt);
  }

  h3 {
    color: var(--site-ink);
    font-size: 1.05rem;
    font-weight: 680;
    letter-spacing: -0.015em;
  }

  .domain-copy p {
    max-width: 42rem;
    margin-top: 0.35rem;
    color: var(--site-muted);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .domain-methods {
    grid-column: 2;
    color: var(--site-faint);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    line-height: 1.65;
  }

  .domain-categories {
    display: flex;
    grid-column: 2;
    flex-wrap: wrap;
    gap: 0 1.1rem;
    margin-top: -0.3rem;
  }

  .domain-categories a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--site-ink-soft);
    font-size: 0.78rem;
    font-weight: 620;
    text-decoration: underline;
    text-decoration-color: var(--site-line-strong);
    text-underline-offset: 0.25rem;
  }

  .domain-categories a:hover {
    color: var(--site-cobalt);
    text-decoration-color: var(--site-cobalt);
  }

  @media (min-width: 900px) {
    .domain-row {
      grid-template-columns: 44px minmax(300px, 1.3fr) minmax(190px, 0.7fr) minmax(220px, 0.8fr);
      gap: 1.35rem;
      align-items: center;
      padding-block: 1.15rem;
    }

    .domain-methods,
    .domain-categories {
      grid-column: auto;
    }

    .domain-categories {
      justify-content: flex-end;
      margin-top: 0;
    }
  }
</style>
