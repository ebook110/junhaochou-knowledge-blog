---
import { ArrowUpRight, FileText } from "lucide-astro";

interface ArticleView {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
}

interface Props {
  article: ArticleView;
  category: { slug: string; name: string };
}

const { article, category } = Astro.props;
const href = `/articles/${article.slug}/`;
const displayDate = article.updatedDate ?? article.pubDate;
const formattedDate = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(displayDate);
---

<article class="article-row">
  <div class="article-icon" aria-hidden="true">
    <FileText class="h-5 w-5" strokeWidth={1.55} />
  </div>

  <div class="article-copy">
    <div class="article-title-line">
      <h3><a href={href}>{article.title}</a></h3>
      <a class="category-link" href={`/categories/${category.slug}/`}>{category.name}</a>
    </div>
    <p>{article.description}</p>
  </div>

  <time datetime={displayDate.toISOString()}>{formattedDate}</time>
  <a class="article-open" href={href} aria-label={`阅读文章：${article.title}`}>
    <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
  </a>
</article>

<style>
  .article-row {
    display: grid;
    min-width: 0;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    gap: 0.85rem;
    align-items: center;
    border-bottom: 1px solid var(--site-line);
    padding-block: 1.15rem;
  }

  .article-row:first-child {
    border-top: 1px solid var(--site-line);
  }

  .article-icon,
  .article-open {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--site-line);
    border-radius: var(--site-radius);
  }

  .article-icon {
    color: var(--site-faint);
  }

  .article-open {
    color: var(--site-cobalt);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .article-open:hover {
    border-color: var(--site-cobalt);
    background: var(--site-cobalt-soft);
  }

  .article-title-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.75rem;
  }

  h3 {
    min-width: min(100%, 18rem);
    color: var(--site-ink);
    font-size: 0.98rem;
    font-weight: 660;
    letter-spacing: -0.01em;
    line-height: 1.45;
  }

  h3 a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--site-cobalt);
  }

  .category-link {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    border: 1px solid var(--site-line);
    border-radius: var(--site-radius);
    padding-inline: 0.5rem;
    color: var(--site-muted);
    font-size: 0.7rem;
    font-weight: 620;
    text-decoration: none;
  }

  .category-link:hover {
    border-color: var(--site-cobalt);
    color: var(--site-cobalt);
  }

  .article-copy > p {
    max-width: 58rem;
    color: var(--site-muted);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  time {
    grid-column: 2;
    color: var(--site-faint);
    font-family: var(--font-mono);
    font-size: 0.69rem;
  }

  @media (min-width: 768px) {
    .article-row {
      grid-template-columns: 44px minmax(0, 1fr) auto 44px;
      gap: 1.15rem;
      padding-block: 1rem;
    }

    time {
      grid-column: auto;
    }
  }
</style>
