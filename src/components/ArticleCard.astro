---
import type { CollectionEntry } from "astro:content";
import { categories } from "../data/site";
import CoverImage from "./CoverImage.astro";
interface Props {
  article: CollectionEntry<"articles">;
  compact?: boolean;
}
const { article, compact = false } = Astro.props;
const category = categories.find((item) => item.slug === article.data.category)!;
const href = `/articles/${article.data.slug}/`;
---

<article
  class:list={["group surface overflow-hidden", compact ? "grid grid-cols-[132px_1fr]" : ""]}
>
  <a
    href={href}
    class:list={["cover-frame relative block", compact ? "min-h-full" : "h-36"]}
    aria-label={`阅读：${article.data.title}`}
    ><CoverImage
      src={article.data.cover.src}
      alt={article.data.cover.alt}
      class="h-full w-full"
      focal={article.data.cover.focal}
    /><span class="absolute inset-x-4 bottom-3 text-xs font-semibold text-white drop-shadow"
      >{category.name}</span
    ></a
  >
  <div class="p-4">
    <div class="flex flex-wrap gap-2">
      <a
        href={`/categories/${category.slug}/`}
        class="text-xs font-medium text-blue-600 dark:text-blue-400">{category.name}</a
      ><span class="text-xs text-slate-400">{article.data.pubDate.toLocaleDateString("zh-CN")}</span
      >
    </div><h3
      class="mt-2 text-base font-semibold text-slate-900 group-hover:text-blue-600 dark:text-white"
    >
      <a href={href}>{article.data.title}</a>
    </h3><p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
      {article.data.description}
    </p><div class="mt-3 flex flex-wrap gap-1">
      {
        article.data.tags.slice(0, 3).map((tag) => (
          <a
            href={`/tags/${tag}/`}
            class="bg-slate-100 px-2 py-0.5 text-xs text-slate-500 hover:text-blue-600 dark:bg-slate-800 dark:text-slate-400"
          >
            {tag}
          </a>
        ))
      }
    </div>
  </div>
</article>
