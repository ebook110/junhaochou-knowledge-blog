---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { categories } from "../../data/site";
import { getPublishedArticles } from "../../utils/articles";
export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}
const { category } = Astro.props;
const articles = (await getPublishedArticles()).filter(
  (article) => article.data.category === category.slug,
);
---

<BaseLayout title={category.name} description={category.description}
  ><div class="container py-10">
    <a class="text-sm text-blue-600" href="/categories/">分类</a><h1
      class="mt-2 text-3xl font-bold text-slate-900 dark:text-white"
    >
      {category.name}
    </h1><p class="mt-3 text-slate-500">{category.description}</p><div
      class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3"
    >
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  </div></BaseLayout
>
