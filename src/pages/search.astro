---
import { Search } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="搜索" description="使用中文关键词搜索全部技术文章。"
  ><div class="container max-w-4xl py-10">
    <p class="subtle">标题、摘要、正文与标签均可检索</p><h1
      class="mt-1 text-3xl font-bold text-slate-900 dark:text-white"
    >
      搜索知识库
    </h1><div
      class="mt-8 flex border border-slate-300 bg-white p-2 dark:border-slate-700 dark:bg-slate-900"
    >
      <Search class="m-2 h-5 w-5 text-blue-600" /><input
        id="search-page-input"
        class="min-w-0 flex-1 bg-transparent px-2 py-2 outline-none"
        placeholder="输入中文或英文关键词"
      /><button id="search-page-button" class="bg-blue-600 px-5 text-sm font-medium text-white"
        >搜索</button
      >
    </div><div id="search-page-results" class="mt-6 space-y-3"></div>
  </div></BaseLayout
>
<script>
  interface PagefindItemData {
    url: string;
    meta: { title: string };
    excerpt: string;
  }
  interface PagefindResult {
    data: () => Promise<PagefindItemData>;
  }
  interface PagefindApi {
    search: (query: string) => Promise<{ results: PagefindResult[] }>;
  }
  const input = document.querySelector<HTMLInputElement>("#search-page-input");
  const output = document.querySelector<HTMLElement>("#search-page-results");
  const pagefindPath = "/pagefind/pagefind.js";
  let pagefind: PagefindApi | undefined;
  async function search() {
    const query = input?.value.trim();
    if (!query || !output) return;
    pagefind ??= (await import(/* @vite-ignore */ pagefindPath)) as unknown as PagefindApi;
    const result = await pagefind.search(query);
    const items = await Promise.all(result.results.map((item) => item.data()));
    output.innerHTML = items.length
      ? items
          .map(
            (item) =>
              `<a class="block surface p-4 hover:border-blue-400" href="${item.url}"><h2 class="font-semibold">${item.meta.title}</h2><p class="mt-2 text-sm text-slate-500">${item.excerpt}</p></a>`,
          )
          .join("")
      : '<p class="subtle">没有找到匹配内容。</p>';
  }
  document.querySelector("#search-page-button")?.addEventListener("click", search);
  input?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") search();
  });
</script>
