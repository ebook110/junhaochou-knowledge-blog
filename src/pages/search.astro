---
import BaseLayout from "../layouts/BaseLayout.astro";
import PagefindSearch from "../components/PagefindSearch.astro";
---

<BaseLayout title="搜索" description="使用中文关键词搜索全部技术文章。"
  ><div class="container max-w-4xl py-10">
    <p class="subtle">研究、项目、文章正文与标签均可检索</p><h1
      class="mt-1 text-3xl font-bold text-slate-900 dark:text-white"
    >
      搜索知识库
    </h1><p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">
      搜索在浏览器中读取构建时生成的 Pagefind 静态索引；可按内容类型、研究领域和标签缩小范围。
    </p>
    <PagefindSearch id="search-page" variant="page" limit={40} autoLoad />
  </div></BaseLayout
>
