---
import { render } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getDomain, site } from "../../data/site";
import { getPublishedArticles } from "../../utils/articles";
import {
  getPublishedProjects,
  getPublishedResearch,
  researchStatusLabels,
  type ResearchEntry,
} from "../../utils/content";
import { relatedSlugs } from "../../utils/relations";

export async function getStaticPaths() {
  const entries = await getPublishedResearch();
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: ResearchEntry };
const { Content } = await render(entry);
const domain = getDomain(entry.data.domain);
const projects = await getPublishedProjects();
const articles = await getPublishedArticles();
const projectSlugs = relatedSlugs(entry.data.relatedProjects, entry.body ?? "", "projects");
const articleSlugs = relatedSlugs(entry.data.relatedArticles, entry.body ?? "", "articles");
const relatedProjects = projects.filter((project) => projectSlugs.has(project.data.slug));
const relatedArticles = articles.filter((article) => articleSlugs.has(article.data.slug));
const url = new URL(`/research/${entry.data.slug}/`, site.url).toString();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ScholarlyArticle",
    headline: entry.data.title,
    description: entry.data.summary,
    dateModified: entry.data.updatedDate.toISOString(),
    author: { "@type": "Person", name: site.name, url: site.url },
    about: domain.name,
    keywords: entry.data.tags,
    mainEntityOfPage: url,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "首页", item: site.url },
      {
        "@type": "ListItem",
        position: 2,
        name: "研究",
        item: new URL("/research/", site.url).toString(),
      },
      { "@type": "ListItem", position: 3, name: entry.data.title, item: url },
    ],
  },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  imageAlt="JunhaoChou 科研计算与材料研究知识结构图"
  ogType="article"
  jsonLd={jsonLd}
  pagefind={{ type: "research", domain: entry.data.domain, tags: entry.data.tags }}
>
  <div class="container py-10 lg:py-14">
    <nav class="text-sm text-[var(--site-muted)]" aria-label="面包屑">
      <a class="hover:text-[var(--site-cobalt)]" href="/">首页</a>
      <span aria-hidden="true"> / </span>
      <a class="hover:text-[var(--site-cobalt)]" href="/research/">研究</a>
    </nav>
    <div class="mt-7 grid gap-10 xl:grid-cols-[minmax(0,800px)_280px] xl:items-start">
      <article class="min-w-0" data-pagefind-body>
        <header class="border-b border-[var(--site-line)] pb-8">
          <div class="flex flex-wrap items-center gap-3 text-sm">
            <span class="font-semibold text-[var(--site-cobalt)]">{domain.name}</span>
            <span class="text-[var(--site-faint)]">{researchStatusLabels[entry.data.status]}</span>
          </div>
          <h1
            class="mt-4 text-3xl font-semibold leading-tight tracking-tight text-[var(--site-ink)] sm:text-4xl"
          >
            {entry.data.title}
          </h1>
          <p class="mt-5 text-base leading-8 text-[var(--site-muted)]">{entry.data.summary}</p>
          <p class="mt-5 text-sm text-[var(--site-faint)]">
            更新于 <time datetime={entry.data.updatedDate.toISOString()}
              >{entry.data.updatedDate.toLocaleDateString("zh-CN")}</time
            >
          </p>
        </header>

        <section class="mt-8" aria-labelledby="research-questions">
          <h2 id="research-questions" class="section-title">关注的问题</h2>
          <ul class="mt-4 grid gap-3">
            {
              entry.data.questions.map((question) => (
                <li class="border-l border-[var(--site-cobalt)] py-1 pl-4 text-sm leading-7 text-[var(--site-ink-soft)]">
                  {question}
                </li>
              ))
            }
          </ul>
        </section>

        <div class="prose-article mt-10"><Content /></div>

        <section
          class="mt-10 border border-[var(--site-line)] bg-[var(--site-surface-muted)] p-5"
          aria-labelledby="research-disclosure"
        >
          <h2 id="research-disclosure" class="text-sm font-semibold text-[var(--site-ink)]">
            公开说明
          </h2>
          <p class="mt-2 text-sm leading-7 text-[var(--site-muted)]">{entry.data.disclosure}</p>
        </section>
      </article>

      <aside class="surface p-5 xl:sticky xl:top-24" aria-label="研究信息">
        <h2 class="text-sm font-semibold text-[var(--site-ink)]">方法与工具</h2>
        <dl class="mt-5 space-y-5 text-sm">
          <div>
            <dt class="text-[var(--site-faint)]">方法</dt>
            <dd class="mt-2 flex flex-wrap gap-2">
              {
                entry.data.methods.map((method) => (
                  <span class="border border-[var(--site-line)] px-2 py-1">{method}</span>
                ))
              }
            </dd>
          </div>
          <div>
            <dt class="text-[var(--site-faint)]">工具</dt>
            <dd class="mt-2 text-[var(--site-ink-soft)]">{entry.data.tools.join(" · ")}</dd>
          </div>
          <div>
            <dt class="text-[var(--site-faint)]">标签</dt>
            <dd class="mt-2 text-[var(--site-ink-soft)]">{entry.data.tags.join(" · ")}</dd>
          </div>
          {
            entry.data.links.length > 0 && (
              <div>
                <dt class="text-[var(--site-faint)]">公开链接</dt>
                <dd class="mt-2 grid gap-2">
                  {entry.data.links.map((link) => (
                    <a
                      class="text-[var(--site-cobalt)] underline"
                      href={link.url}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {link.label}
                    </a>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
      </aside>
    </div>

    {
      (relatedProjects.length > 0 || relatedArticles.length > 0) && (
        <section
          class="mt-14 border-t border-[var(--site-line)] pt-8"
          aria-labelledby="research-related"
        >
          <h2 id="research-related" class="section-title">
            关联内容
          </h2>
          {relatedProjects.length > 0 && (
            <div class="mt-5 grid gap-4 md:grid-cols-2">
              {relatedProjects.map((project) => (
                <ProjectCard
                  project={project.data}
                  domainLabel={getDomain(project.data.domain).name}
                />
              ))}
            </div>
          )}
          {relatedArticles.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-3">
              {relatedArticles.map((article) => (
                <a
                  class="inline-flex min-h-11 items-center border border-[var(--site-line)] px-4 py-2 text-sm text-[var(--site-ink-soft)] hover:border-[var(--site-cobalt)] hover:text-[var(--site-cobalt)]"
                  href={`/articles/${article.data.slug}/`}
                >
                  {article.data.title}
                </a>
              ))}
            </div>
          )}
        </section>
      )
    }
  </div>
</BaseLayout>
