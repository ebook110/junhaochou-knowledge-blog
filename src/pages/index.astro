---
import { ArrowRight, BookOpen, Boxes, Search } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import CoverImage from "../components/CoverImage.astro";
import Sidebar from "../components/Sidebar.astro";
import { categories, site, tools } from "../data/site";
import { getPublishedArticles } from "../utils/articles";

const articles = await getPublishedArticles();
const featured = articles.filter((item) => item.data.featured).slice(0, 3);
const latest = articles.slice(0, 4);
const series = [
  ...new Set(articles.map((article) => article.data.series).filter(Boolean)),
] as string[];
---

<BaseLayout
  image="/images/covers/hero-engineering.webp"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.url,
    description: site.description,
  }}
>
  <section class="home-hero overflow-hidden border-b border-slate-800 text-white">
    <div
      class="container relative grid min-h-[390px] items-center gap-8 py-14 lg:grid-cols-[1.05fr_.95fr] lg:py-16"
    >
      <div class="relative z-10 max-w-2xl">
        <p class="text-sm font-semibold text-sky-200">可复现的技术记录</p>
        <h1 class="mt-4 text-4xl font-bold leading-tight sm:text-5xl">{site.tagline}</h1>
        <p class="mt-5 max-w-xl text-base leading-8 text-slate-200">
          材料计算、工程软件、Linux/VPS
          与工具实践的中文知识库。每篇文章保留适用环境、验证日期和可追溯上下文。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <button
            data-search-open
            class="inline-flex items-center gap-2 rounded-md bg-blue-500 px-5 py-3 text-sm font-semibold hover:bg-blue-400"
          >
            <Search class="h-4 w-4" /> 搜索知识库
          </button>
          <a
            href="/articles/"
            class="inline-flex items-center gap-2 rounded-md border border-slate-400/70 px-5 py-3 text-sm font-semibold hover:border-white hover:bg-white/10"
          >
            <BookOpen class="h-4 w-4" /> 浏览文章
          </a>
        </div>
      </div>
      <div class="relative h-56 overflow-hidden rounded-md border border-white/20 sm:h-72">
        <CoverImage
          src="/images/covers/hero-engineering.webp"
          alt="蓝色工程文档抽象图，包含网格、节点与结构化数据元素"
          class="h-full w-full"
          loading="eager"
        />
        <div
          class="absolute inset-x-0 bottom-0 border-t border-white/15 bg-slate-950/35 px-5 py-4 backdrop-blur-sm"
        >
          <p class="text-sm font-semibold">从实验记录到长期系统</p>
          <p class="mt-1 text-sm text-slate-200">清晰来源、明确条件、持续复核。</p>
        </div>
      </div>
    </div>
  </section>

  <div class="container py-8 lg:py-10">
    <div class="grid gap-7 xl:grid-cols-[220px_minmax(0,1fr)_220px]">
      <div class="hidden xl:block"><Sidebar articles={articles} side="left" /></div>
      <div class="min-w-0 space-y-12">
        <section aria-labelledby="category-heading">
          <div
            class="flex items-end justify-between gap-4 border-b border-slate-200 pb-4 dark:border-slate-800"
          >
            <div>
              <p class="subtle">按主题快速定位</p>
              <h2 id="category-heading" class="section-title mt-1">知识分类</h2>
            </div>
            <a
              class="inline-flex items-center gap-1 text-sm font-semibold text-blue-700 hover:text-blue-800 dark:text-blue-400"
              href="/categories/"
            >
              查看全部 <ArrowRight class="h-4 w-4" />
            </a>
          </div>
          <div class="category-index mt-5 grid gap-3 sm:grid-cols-2">
            {
              categories.map((category) => (
                <a
                  class="surface group p-4 hover:border-blue-400"
                  href={`/categories/${category.slug}/`}
                >
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <h3 class="font-semibold text-slate-950 group-hover:text-blue-700 dark:text-white dark:group-hover:text-blue-300">
                        {category.name}
                      </h3>
                      <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
                        {category.description}
                      </p>
                    </div>
                    <span class="text-sm tabular-nums text-slate-400">
                      {articles.filter((article) => article.data.category === category.slug).length}
                    </span>
                  </div>
                </a>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="featured-heading">
          <div
            class="flex items-end justify-between gap-4 border-b border-slate-200 pb-4 dark:border-slate-800"
          >
            <div>
              <p class="subtle">重点整理与复核</p>
              <h2 id="featured-heading" class="section-title mt-1">精选文章</h2>
            </div>
            <a
              class="text-sm font-semibold text-blue-700 hover:text-blue-800 dark:text-blue-400"
              href="/articles/">文章归档</a
            >
          </div>
          <div class="mt-5 grid gap-4 md:grid-cols-3">
            {featured.map((article) => <ArticleCard article={article} />)}
          </div>
        </section>

        <section aria-labelledby="latest-heading">
          <div class="border-b border-slate-200 pb-4 dark:border-slate-800">
            <p class="subtle">最近写入与验证</p>
            <h2 id="latest-heading" class="section-title mt-1">最新更新</h2>
          </div>
          <div class="mt-5 space-y-3">
            {latest.map((article) => <ArticleCard article={article} compact />)}
          </div>
        </section>

        <section
          class="grid gap-8 border-y border-slate-200 py-8 md:grid-cols-2 dark:border-slate-800"
        >
          <div>
            <div class="flex items-center gap-3">
              <Boxes class="h-5 w-5 text-blue-700" />
              <div>
                <p class="subtle">按学习顺序组织</p>
                <h2 class="section-title mt-1">系列教程</h2>
              </div>
            </div>
            <div class="mt-5 space-y-2">
              {
                series.map((name) => (
                  <a
                    class="surface flex items-center justify-between gap-4 px-4 py-3 hover:border-blue-400"
                    href={`/series/${encodeURIComponent(name)}/`}
                  >
                    <span class="font-semibold text-slate-900 dark:text-white">{name}</span>
                    <span class="text-sm tabular-nums text-slate-400">
                      {articles.filter((article) => article.data.series === name).length} 篇
                    </span>
                  </a>
                ))
              }
            </div>
          </div>
          <div>
            <p class="subtle">来源优先，保留版本信息</p>
            <h2 class="section-title mt-1">常用工具</h2>
            <div class="mt-5 grid gap-2">
              {
                tools.map((tool) => (
                  <a
                    class="surface px-4 py-3 hover:border-blue-400"
                    href={tool.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    <p class="font-semibold text-slate-900 dark:text-white">{tool.name}</p>
                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                      {tool.description}
                    </p>
                  </a>
                ))
              }
            </div>
          </div>
        </section>

        <section class="grid gap-3 text-center sm:grid-cols-3" aria-label="站点统计">
          <div class="surface py-5">
            <p class="text-3xl font-bold tabular-nums text-blue-700 dark:text-blue-400">
              {articles.length}
            </p><p class="subtle mt-1">已发布文章</p>
          </div>
          <div class="surface py-5">
            <p class="text-3xl font-bold tabular-nums text-blue-700 dark:text-blue-400">
              {categories.length}
            </p><p class="subtle mt-1">一级分类</p>
          </div>
          <div class="surface py-5">
            <p class="text-3xl font-bold tabular-nums text-blue-700 dark:text-blue-400">
              {series.length}
            </p><p class="subtle mt-1">系列教程</p>
          </div>
        </section>
      </div>
      <div class="hidden xl:block"><Sidebar articles={articles} side="right" /></div>
    </div>
  </div>
</BaseLayout>
