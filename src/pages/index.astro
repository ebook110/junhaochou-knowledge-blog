---
import { ArrowRight } from "lucide-astro";
import ArticleRow from "../components/ArticleRow.astro";
import DomainRow from "../components/DomainRow.astro";
import MethodMatrix from "../components/MethodMatrix.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import TensileSpecimen from "../components/TensileSpecimen.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { domains, getCategory, getDomain, site } from "../data/site";
import { getPublishedProjects } from "../utils/content";
import { getPublishedArticles } from "../utils/articles";

const [articles, projects] = await Promise.all([getPublishedArticles(), getPublishedProjects()]);
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
const latestArticles = articles.slice(0, 4);

const matrixColumns: [string, string, string] = ["建立模型", "控制变量", "解释响应"];
const matrixRows = [
  {
    subject: "材料体系",
    cells: ["VNbTaTiZr", "温度 · 组分 · 应变率", "结构演化"] as [string, string, string],
  },
  {
    subject: "分子动力学",
    cells: ["势函数验证", "LAMMPS 拉伸", "位错 · 孪晶"] as [string, string, string],
  },
  {
    subject: "机器学习",
    cells: ["特征工程", "GPR · XGBoost · SVR", "RFECV · SHAP"] as [string, string, string],
  },
];
---

<BaseLayout
  description="JunhaoChou 的材料研究、分子动力学、机器学习与工程系统知识库。"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: site.name,
      url: site.url,
      description: site.description,
      inLanguage: "zh-CN",
    },
    {
      "@context": "https://schema.org",
      "@type": "Person",
      name: site.name,
      url: site.url,
      sameAs: [site.github],
      knowsAbout: ["难熔高熵合金", "分子动力学", "机器学习", "工程系统"],
    },
  ]}
>
  <section class="home-intro" aria-labelledby="home-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 id="home-title">
          <span>材料研究、</span>
          <span>计算方法与工程实践</span>
        </h1>
        <p>
          围绕 VNbTaTiZr 难熔高熵合金，连接分子动力学、力学响应解释、机器学习与可复现的工程系统。
        </p>
        <div class="hero-actions">
          <a class="primary-action" href="/research/">
            进入研究
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
          <a class="secondary-action" href="/projects/">查看项目</a>
        </div>
      </div>

      <MethodMatrix columns={matrixColumns} rows={matrixRows} />
    </div>
  </section>

  <TensileSpecimen />

  <div class="container home-sections">
    <section class="home-section" aria-labelledby="featured-projects-title">
      <SectionHeader
        id="featured-projects-title"
        title="精选项目"
        description="以可追溯方法、工具链和公开边界记录研究与工程实践。"
        href="/projects/"
        linkLabel="全部项目"
      />

      <div class="project-grid">
        {
          featuredProjects.map((project, index) => (
            <div class={`project-slot project-slot-${index + 1}`}>
              <ProjectCard
                project={project.data}
                domainLabel={getDomain(project.data.domain).name}
              />
            </div>
          ))
        }
      </div>
    </section>

    <section class="home-section" aria-labelledby="knowledge-domains-title">
      <SectionHeader
        id="knowledge-domains-title"
        title="知识体系"
        description="四条路径组织现有分类，让研究方法、工程记录与风险意识保持可定位。"
      />

      <ul class="domain-ledger">
        {
          domains.map((domain) => (
            <DomainRow
              domain={domain}
              categories={domain.categorySlugs.map((slug) => getCategory(slug))}
            />
          ))
        }
      </ul>
    </section>

    <section class="home-section" aria-labelledby="latest-articles-title">
      <SectionHeader
        id="latest-articles-title"
        title="最新文章"
        description="保留适用条件、来源和复核上下文的近期技术记录。"
        href="/articles/"
        linkLabel="文章归档"
      />

      <div class="article-ledger">
        {
          latestArticles.map((article) => (
            <ArticleRow article={article.data} category={getCategory(article.data.category)} />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-intro {
    background: var(--site-canvas);
  }

  .hero-grid {
    display: grid;
    min-height: 490px;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    padding-block: clamp(3.75rem, 8vw, 6.5rem);
  }

  .hero-copy {
    min-width: 0;
  }

  h1 {
    max-width: 10em;
    color: var(--site-ink);
    font-size: clamp(2.65rem, 5vw, 4.15rem);
    font-weight: 730;
    letter-spacing: -0.04em;
    line-height: 1.06;
  }

  h1 span {
    display: block;
  }

  .hero-copy > p {
    max-width: 43rem;
    margin-top: clamp(1.4rem, 3vw, 2rem);
    color: var(--site-muted);
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 1.85;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: clamp(1.8rem, 4vw, 2.5rem);
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: var(--site-radius);
    padding-inline: 1.15rem;
    font-size: 0.875rem;
    font-weight: 680;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease;
  }

  .primary-action {
    gap: 0.5rem;
    border-color: #1556c0;
    background: #1556c0;
    color: #ffffff;
  }

  .primary-action:hover {
    border-color: #0e459f;
    background: #0e459f;
  }

  .secondary-action {
    border-color: var(--site-line-strong);
    background: var(--site-surface);
    color: var(--site-ink-soft);
  }

  .secondary-action:hover {
    border-color: var(--site-cobalt);
    color: var(--site-cobalt);
  }

  .home-sections {
    padding-top: clamp(4.75rem, 9vw, 7.5rem);
  }

  .home-section + .home-section {
    margin-top: clamp(5.5rem, 10vw, 8.5rem);
  }

  .project-grid {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .project-slot {
    min-width: 0;
  }

  .domain-ledger,
  .article-ledger {
    margin-top: 1.25rem;
  }

  .domain-ledger {
    list-style: none;
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-slot-3 {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(410px, 0.92fr);
    }

    .hero-grid > :global(.method-matrix) {
      border-left: 1px solid var(--site-line);
      padding-left: clamp(2rem, 4vw, 3.5rem);
    }
  }

  @media (min-width: 1120px) {
    .project-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .project-slot-1 {
      grid-column: span 5;
    }

    .project-slot-2 {
      grid-column: span 4;
    }

    .project-slot-3 {
      grid-column: span 3;
    }
  }

  @media (max-width: 767px) {
    .hero-grid {
      min-height: 0;
      padding-block: 3.25rem 2.75rem;
    }

    h1 {
      font-size: clamp(2.45rem, 12vw, 3.15rem);
      line-height: 1.1;
    }

    .hero-copy > p {
      line-height: 1.75;
    }
  }

  @media (max-width: 430px) {
    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .primary-action,
    .secondary-action {
      width: 100%;
      padding-inline: 0.75rem;
    }
  }
</style>
