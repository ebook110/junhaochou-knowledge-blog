---
import { render } from "astro:content";
import {
  ArrowLeft,
  ArrowRight,
  BookOpen,
  Calendar,
  Clock3,
  GitBranch,
  Layers3,
  ShieldCheck,
  Tag,
} from "lucide-astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import ArticleEnhancements from "../../components/ArticleEnhancements.astro";
import CoverImage from "../../components/CoverImage.astro";
import Giscus from "../../components/Giscus.astro";
import MobileToc from "../../components/MobileToc.astro";
import { categories, domains, site } from "../../data/site";
import { bySeries, getPublishedArticles, readingMinutes } from "../../utils/articles";
import { getPublishedProjects, getPublishedResearch } from "../../utils/content";
import { relatedSlugs } from "../../utils/relations";

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const [articles, researchEntries, projectEntries] = await Promise.all([
  getPublishedArticles(),
  getPublishedResearch(),
  getPublishedProjects(),
]);
const category = categories.find((item) => item.slug === article.data.category)!;
const domain = domains.find((item) =>
  (item.categorySlugs as readonly string[]).includes(article.data.category),
);
const series = article.data.series ? bySeries(articles, article.data.series) : [];
const navigationPool = series.length > 1 ? series : articles;
const navigationIndex = navigationPool.findIndex((item) => item.id === article.id);
const adjacent = {
  previous: navigationPool[navigationIndex - 1],
  next: navigationPool[navigationIndex + 1],
};
const outboundArticleSlugs = relatedSlugs(article.data.related, article.body ?? "", "articles");
const related = articles.filter((item) => outboundArticleSlugs.has(item.data.slug)).slice(0, 4);
const backlinks = [
  ...articles
    .filter((item) =>
      relatedSlugs(item.data.related, item.body ?? "", "articles").has(article.data.slug),
    )
    .filter((item) => !outboundArticleSlugs.has(item.data.slug))
    .map((item) => ({
      href: `/articles/${item.data.slug}/`,
      title: item.data.title,
      type: "文章",
    })),
  ...researchEntries
    .filter((item) =>
      relatedSlugs(item.data.relatedArticles, item.body ?? "", "articles").has(article.data.slug),
    )
    .map((item) => ({
      href: `/research/${item.data.slug}/`,
      title: item.data.title,
      type: "研究",
    })),
  ...projectEntries
    .filter((item) =>
      relatedSlugs(item.data.relatedArticles, item.body ?? "", "articles").has(article.data.slug),
    )
    .map((item) => ({
      href: `/projects/${item.data.slug}/`,
      title: item.data.title,
      type: "项目",
    })),
];
const minutes = readingMinutes(article.body ?? "");
const tocHeadings = article.data.toc ? headings.filter((heading) => heading.depth < 4) : [];
const articleUrl = new URL(`/articles/${article.data.slug}/`, site.url).toString();
const canonicalUrl = article.data.canonical ?? articleUrl;
const dateModified = article.data.updatedDate ?? article.data.pubDate;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.data.title,
    description: article.data.description,
    image: new URL(article.data.cover.src, site.url).toString(),
    datePublished: article.data.pubDate.toISOString(),
    dateModified: dateModified.toISOString(),
    inLanguage: "zh-CN",
    keywords: article.data.tags.join(", "),
    articleSection: category.name,
    author: { "@type": "Person", name: article.data.author, url: site.url },
    publisher: { "@type": "Person", name: site.name, url: site.url },
    mainEntityOfPage: canonicalUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "首页", item: site.url },
      {
        "@type": "ListItem",
        position: 2,
        name: "文章",
        item: new URL("/articles/", site.url).toString(),
      },
      { "@type": "ListItem", position: 3, name: article.data.title, item: articleUrl },
    ],
  },
];
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  canonical={canonicalUrl}
  image={article.data.cover.src}
  imageAlt={article.data.cover.alt}
  ogType="article"
  jsonLd={jsonLd}
  pagefind={{
    type: "article",
    domain: domain?.slug,
    tags: article.data.tags,
    series: article.data.series,
  }}
>
  <div class="container py-8 lg:py-12">
    <ArticleLayout pagefindBody>
      <div slot="context" class="space-y-6 text-sm">
        <nav aria-label="文章上下文" class="context-nav">
          <p class="context-label">内容路径</p>
          <a href="/articles/">全部文章</a>
          {domain && <a href={`/articles/?domain=${domain.slug}`}>{domain.name}</a>}
          <a href={`/categories/${category.slug}/`}>{category.name}</a>
        </nav>
        {
          article.data.series && (
            <section>
              <p class="context-label">所属系列</p>
              <a
                class="context-strong"
                href={`/series/${encodeURIComponent(article.data.series)}/`}
              >
                {article.data.series}
              </a>
              <ol class="context-series mt-3">
                {series.map((item, position) => (
                  <li>
                    <a
                      class:list={[item.id === article.id && "is-current"]}
                      href={`/articles/${item.data.slug}/`}
                    >
                      <span>{String(position + 1).padStart(2, "0")}</span>
                      {item.data.title}
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          )
        }
      </div>

      <header class="article-header">
        <nav class="breadcrumb" aria-label="面包屑">
          <a href="/">首页</a><span aria-hidden="true">/</span><a href="/articles/">文章</a><span
            aria-hidden="true">/</span
          ><span>{category.name}</span>
        </nav>
        <div class="mt-6 flex flex-wrap items-center gap-2">
          {domain && <span class="meta-chip">{domain.name}</span>}
          <a class="meta-chip" href={`/categories/${category.slug}/`}>{category.name}</a>
        </div>
        <h1>{article.data.title}</h1>
        <p class="article-deck">{article.data.description}</p>
        <div class="article-meta" aria-label="文章元数据">
          <span
            ><Calendar aria-hidden="true" />发布于 {
              article.data.pubDate.toLocaleDateString("zh-CN")
            }</span
          >
          <span><Clock3 aria-hidden="true" />预计 {minutes} 分钟</span>
          <span
            ><ShieldCheck aria-hidden="true" />最后验证 {
              article.data.lastVerified?.toLocaleDateString("zh-CN") ?? "未标注"
            }</span
          >
        </div>
      </header>

      <figure class="article-cover">
        <div class="cover-frame aspect-[16/9]">
          <CoverImage
            src={article.data.cover.src}
            alt={article.data.cover.alt}
            class="h-full w-full"
            loading="eager"
            focal={article.data.cover.focal}
          />
        </div>
        {
          article.data.environment.length > 0 && (
            <figcaption>{article.data.environment.join(" · ")}</figcaption>
          )
        }
      </figure>

      <MobileToc headings={tocHeadings} />

      <div class="prose-article article-body">
        <Content />
      </div>

      {
        article.data.disclaimer && (
          <section class="article-disclosure" aria-labelledby="article-disclosure-heading">
            <h2 id="article-disclosure-heading">使用边界</h2>
            <p>{article.data.disclaimer}</p>
          </section>
        )
      }

      <nav class="article-pager" aria-label="相邻文章">
        {
          adjacent.previous ? (
            <a href={`/articles/${adjacent.previous.data.slug}/`}>
              <span>
                <ArrowLeft aria-hidden="true" />
                上一篇
              </span>
              <strong>{adjacent.previous.data.title}</strong>
            </a>
          ) : (
            <span />
          )
        }
        {
          adjacent.next && (
            <a class="text-right" href={`/articles/${adjacent.next.data.slug}/`}>
              <span>
                下一篇
                <ArrowRight aria-hidden="true" />
              </span>
              <strong>{adjacent.next.data.title}</strong>
            </a>
          )
        }
      </nav>

      {
        related.length > 0 && (
          <section class="article-relations" aria-labelledby="related-heading">
            <div class="relation-heading">
              <div>
                <BookOpen aria-hidden="true" />
                <h2 id="related-heading">相关文章</h2>
              </div>
              <p>作者明确关联的延伸阅读</p>
            </div>
            <div class="grid gap-3 md:grid-cols-2">
              {related.map((item) => (
                <ArticleCard article={item} />
              ))}
            </div>
          </section>
        )
      }

      {
        backlinks.length > 0 && (
          <section class="article-backlinks" aria-labelledby="backlinks-heading">
            <div class="relation-heading">
              <div>
                <GitBranch aria-hidden="true" />
                <h2 id="backlinks-heading">被引用于</h2>
              </div>
              <p>在本站知识关系中引用这篇文章的内容</p>
            </div>
            <ul>
              {backlinks.map((item) => (
                <li>
                  <a href={item.href}>
                    <span>{item.title}</span>
                    <small>{item.type}</small>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <Giscus />

      <div slot="aside" class="space-y-5">
        {
          tocHeadings.length > 0 && (
            <section class="aside-section">
              <p class="aside-title">本页目录</p>
              <nav class="mt-3" aria-label="文章目录">
                {tocHeadings.map((heading) => (
                  <a
                    class:list={["toc-link", heading.depth === 3 ? "ml-3" : ""]}
                    href={`#${heading.slug}`}
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>
            </section>
          )
        }
        <section class="aside-section">
          <p class="aside-title flex items-center gap-2"><Layers3 aria-hidden="true" />文章信息</p>
          <dl class="article-facts">
            <div><dt>难度</dt><dd>{article.data.difficulty}</dd></div>
            <div><dt>前置条件</dt><dd>{article.data.prerequisites.join("、") || "无"}</dd></div>
            <div><dt>适用环境</dt><dd>{article.data.environment.join("、") || "未标注"}</dd></div>
            {
              article.data.series && (
                <div>
                  <dt>系列进度</dt>
                  <dd>
                    {series.findIndex((item) => item.id === article.id) + 1}/{series.length}
                  </dd>
                </div>
              )
            }
          </dl>
        </section>
        <section class="aside-section">
          <p class="aside-title flex items-center gap-2"><Tag aria-hidden="true" />标签</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              article.data.tags.map((tag) => (
                <a class="tag-link" href={`/tags/${encodeURIComponent(tag)}/`}>
                  {tag}
                </a>
              ))
            }
          </div>
        </section>
      </div>
    </ArticleLayout>
  </div>
  <ArticleEnhancements />
</BaseLayout>
