---
import { ArrowUpRight } from "lucide-astro";
import ArticleDomainSection from "../../components/ArticleDomainSection.astro";
import { categories, domains, site, tools } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedArticles } from "../../utils/articles";

const articles = await getPublishedArticles();
const series = [
  ...new Set(articles.map((article) => article.data.series).filter(Boolean)),
] as string[];
const tagFrequency = new Map<string, number>();
articles.forEach((article) =>
  article.data.tags.forEach((tag) => tagFrequency.set(tag, (tagFrequency.get(tag) ?? 0) + 1)),
);
const popularTags = [...tagFrequency.keys()]
  .sort((left, right) => (tagFrequency.get(right) ?? 0) - (tagFrequency.get(left) ?? 0))
  .slice(0, 5);

const archivePaths = [
  {
    href: "/series/",
    title: "系列",
    description: series.slice(0, 3).join(" · "),
  },
  {
    href: "/categories/",
    title: "分类",
    description: categories
      .slice(0, 4)
      .map((category) => category.name)
      .join(" · "),
  },
  {
    href: "/tags/",
    title: "标签",
    description: popularTags.join(" · "),
  },
  {
    href: "/tools/",
    title: "工具",
    description: tools.map((tool) => tool.name).join(" · "),
  },
];

const domainGroups = domains.map((domain) => {
  const domainCategorySlugs = new Set<string>(domain.categorySlugs);
  return {
    domain,
    categories: domain.categorySlugs.map((slug) =>
      categories.find((category) => category.slug === slug)!,
    ),
    articles: articles.filter((article) => domainCategorySlugs.has(article.data.category)),
  };
});
const pageDescription = "按知识领域、系列、分类与标签浏览 JunhaoChou 的技术文章。";
const pageUrl = new URL("/articles/", site.url).toString();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "文章",
    description: pageDescription,
    url: pageUrl,
    isPartOf: { "@type": "WebSite", name: site.name, url: site.url },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "首页", item: site.url },
      { "@type": "ListItem", position: 2, name: "文章", item: pageUrl },
    ],
  },
];
---

<BaseLayout title="文章" description={pageDescription} jsonLd={jsonLd}>
  <div class="container articles-page">
    <header class="articles-intro">
      <div class="articles-intro-copy">
        <h1>文章</h1>
        <p>
          从材料与科研计算，到工程自动化、系统部署和数字风险；每篇记录尽量保留适用条件、来源、验证日期与限制边界。
        </p>
      </div>

      <nav class="domain-shortcuts" aria-label="按知识领域跳转">
        {
          domains.map((domain) => (
            <a href={`#${domain.slug}`}>
              <span>{domain.name}</span>
              <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
            </a>
          ))
        }
      </nav>
    </header>

    <nav class="archive-paths" aria-label="其他文章浏览入口">
      {
        archivePaths.map((path) => (
          <a href={path.href}>
            <span class="archive-path-title">
              {path.title}
              <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
            </span>
            <span class="archive-path-description">{path.description}</span>
          </a>
        ))
      }
    </nav>

    <div class="domain-article-groups">
      {
        domainGroups.map((group) => (
          <ArticleDomainSection
            domain={group.domain}
            categories={group.categories}
            articles={group.articles}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .articles-page {
    padding-block: clamp(3.5rem, 7vw, 6.25rem);
  }

  .articles-intro {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: end;
    border-bottom: 1px solid var(--site-line-strong);
    padding-bottom: clamp(2.25rem, 5vw, 4rem);
  }

  .articles-intro-copy {
    max-width: 48rem;
  }

  h1 {
    color: var(--site-ink);
    font-size: clamp(3.2rem, 7vw, 5.2rem);
    font-weight: 730;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .articles-intro-copy p {
    max-width: 43rem;
    margin-top: 1.5rem;
    color: var(--site-muted);
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 1.85;
  }

  .domain-shortcuts {
    min-width: 0;
    border-top: 1px solid var(--site-line-strong);
  }

  .domain-shortcuts a {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--site-line);
    color: var(--site-ink-soft);
    font-size: 0.86rem;
    font-weight: 620;
    text-decoration: none;
  }

  .domain-shortcuts a:hover {
    color: var(--site-cobalt);
  }

  .archive-paths {
    display: grid;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    border-block: 1px solid var(--site-line);
  }

  .archive-paths a {
    display: flex;
    min-width: 0;
    min-height: 112px;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--site-line);
    padding: 1.1rem;
    color: var(--site-ink);
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .archive-paths a:last-child {
    border-bottom: 0;
  }

  .archive-paths a:hover {
    background: var(--site-cobalt-soft);
  }

  .archive-path-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.9rem;
    font-weight: 680;
  }

  .archive-path-title :global(svg) {
    color: var(--site-cobalt);
  }

  .archive-path-description {
    color: var(--site-muted);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .domain-article-groups {
    display: grid;
    gap: clamp(4.75rem, 9vw, 7.75rem);
    margin-top: clamp(5.5rem, 10vw, 8rem);
  }

  @media (min-width: 720px) {
    .archive-paths {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .archive-paths a {
      border-right: 1px solid var(--site-line);
      border-bottom: 0;
    }

    .archive-paths a:last-child {
      border-right: 0;
    }
  }

  @media (min-width: 900px) {
    .articles-intro {
      grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
    }
  }

  @media (max-width: 719px) {
    .archive-paths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .archive-paths a:nth-child(odd) {
      border-right: 1px solid var(--site-line);
    }

    .archive-paths a:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  @media (max-width: 420px) {
    .archive-paths {
      grid-template-columns: 1fr;
    }

    .archive-paths a,
    .archive-paths a:nth-child(odd),
    .archive-paths a:nth-last-child(-n + 2) {
      min-height: 96px;
      border-right: 0;
      border-bottom: 1px solid var(--site-line);
    }

    .archive-paths a:last-child {
      border-bottom: 0;
    }
  }
</style>
