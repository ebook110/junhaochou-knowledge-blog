---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在" description="请求的页面不存在。"
  ><div class="container py-24 text-center">
    <p class="text-sm font-medium text-blue-600">404</p><h1
      class="mt-3 text-4xl font-bold text-slate-900 dark:text-white"
    >
      页面没有被找到
    </h1><p class="mt-4 text-slate-500">链接可能已更新，或地址输入有误。</p><a
      class="mt-8 inline-block bg-blue-600 px-5 py-3 text-sm font-medium text-white"
      href="/">返回首页</a
    >
  </div></BaseLayout
>
