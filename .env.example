# Optional: Giscus comments. Leave blank to hide comments.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=

# Optional: external analytics. Leave blank to disable.
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=

# Docker loopback port. Blank uses 8080; local production smoke uses 8081.
# Production sets the host-specific value through the VPS_HOST_PORT Actions secret.
HOST_PORT=
